# Copy to .env/dev.env (git-ignored) and fill in. See docs/ENVIRONMENT_VARIABLES.md for every variable.
# host.docker.internal = the machine running Docker (a local PostgreSQL); change it for a remote database.
R2DBC_URL=r2dbc:postgresql://host.docker.internal:5432/outbox-gateway
DB_URL=jdbc:postgresql://host.docker.internal:5432/outbox-gateway
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Required in any real environment: base64 AES-256 key (the built-in default is a development key)
GATEWAY_ENCRYPTION_KEY=
